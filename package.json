{
  "name": "readiness-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GPS de conclusao para projetos SaaS construidos com agentes de IA.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:framework": "tsx scripts/validate-framework.ts",
    "gates": "npm run typecheck && npm run validate:framework && npm test",
    "report": "tsx scripts/report.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "reconcile": "tsx scripts/reconcile.ts",
    "scan": "tsx scripts/scan.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  }
}
